<div class="hero-carousel-container">
  
  <!-- DESKTOP VIDEO (Hidden on Mobile) -->
  <div class="hero-desktop-video">
    <video autoplay loop muted playsinline>
      <source src="{{ 'hero-video.mp4' | asset_url }}" type="video/mp4">
    </video>
  </div>

  <!-- CONTENT OVERLAY (Desktop & Mobile) -->
  <div class="hero-content">
    <h2 class="hero-title">{{ section.settings.heading }}</h2>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="button hero-button">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>

  <!-- MOBILE CAROUSEL (Hidden on Desktop) -->
  <div class="hero-mobile-carousel">
    <div class="carousel-track">
      <img src="{{ 'carousel-1.jpg' | asset_url }}" class="carousel-image active" alt="Carousel 1">
      <img src="{{ 'carousel-2.jpg' | asset_url }}" class="carousel-image" alt="Carousel 2">
      <img src="{{ 'carousel-3.jpg' | asset_url }}" class="carousel-image" alt="Carousel 3">
      <img src="{{ 'carousel-4.jpg' | asset_url }}" class="carousel-image" alt="Carousel 4">
      <img src="{{ 'carousel-5.jpg' | asset_url }}" class="carousel-image" alt="Carousel 5">
    </div>
    
    <div class="carousel-controls">
      <button class="carousel-btn prev-btn" aria-label="Previous">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button class="carousel-btn next-btn" aria-label="Next">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
    <div class="vignette-overlay"></div>
  </div>
</div>

<style>
  .hero-carousel-container {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background-color: #000;
    color: #fff;
    overflow: hidden;
  }

  /* Desktop Video */
  .hero-desktop-video {
    display: none; /* Hidden on mobile */
  }

  /* Mobile Carousel */
  .hero-mobile-carousel {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .carousel-track {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .carousel-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    opacity: 0;
    transition: opacity 0.8s ease-in-out;
  }

  .carousel-image.active {
    opacity: 1;
    z-index: 1;
  }

  /* Controls */
  .carousel-controls {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 1rem;
    z-index: 4;
  }

  .carousel-btn {
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s;
  }

  /* Overlay & Content */
  .vignette-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 2;
    pointer-events: none;
  }

  .hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 2rem 2rem 8rem 2rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-title {
    font-size: 2rem;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: #fff;
    font-family: var(--font-heading-family);
  }

  .hero-button {
    display: inline-block;
    padding: 1rem 2rem;
    background: #fff;
    color: #000;
    text-decoration: none;
    font-weight: bold;
    border-radius: 4px;
    transition: opacity 0.3s;
  }

  /* Desktop Styles */
  @media (min-width: 750px) {
    /* Show Video, Hide Carousel */
    .hero-desktop-video {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    .hero-desktop-video video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .hero-mobile-carousel {
      display: none !important;
    }

    .vignette-overlay {
      z-index: 2;
    }

    /* Content styling on desktop */
    .hero-content {
      align-items: flex-start;
      text-align: left;
      padding: 4rem 6rem;
      justify-content: center;
      height: 100%;
      bottom: auto;
      top: 0;
    }

    .hero-title {
      font-size: 4rem;
      margin-bottom: 2rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const track = document.querySelector('.carousel-track');
    if (!track) return;
    
    const images = track.querySelectorAll('.carousel-image');
    const prevBtn = document.querySelector('.prev-btn');
    const nextBtn = document.querySelector('.next-btn');
    let currentIndex = 0;
    const intervalTime = 5000;
    let autoPlayInterval;

    function showImage(index) {
      images.forEach((img, i) => {
        img.classList.remove('active');
        if (i === index) {
          img.classList.add('active');
        }
      });
    }

    function nextSlide() {
      currentIndex = (currentIndex + 1) % images.length;
      showImage(currentIndex);
    }

    function prevSlide() {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      showImage(currentIndex);
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        nextSlide();
        resetInterval();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        prevSlide();
        resetInterval();
      });
    }

    function startInterval() {
      autoPlayInterval = setInterval(nextSlide, intervalTime);
    }

    function resetInterval() {
      clearInterval(autoPlayInterval);
      startInterval();
    }

    startInterval();
  });
</script>

{% schema %}
{
  "name": "Hero Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wear Your Name"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop all →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Carousel"
    }
  ]
}
{% endschema %}
