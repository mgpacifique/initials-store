{{ 'split-hero-overlay.css' | asset_url | stylesheet_tag }}

<div class="split-hero-container">
  <div class="split-hero-images">
    <div class="split-hero-image-half">
      {%- if section.settings.image_left != blank -%}
        <img src="{{ section.settings.image_left | image_url: width: 1500 }}" alt="{{ section.settings.image_left.alt }}" loading="lazy" width="1500" height="1500">
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="split-hero-image-half">
      {%- if section.settings.image_right != blank -%}
        <img src="{{ section.settings.image_right | image_url: width: 1500 }}" alt="{{ section.settings.image_right.alt }}" loading="lazy" width="1500" height="1500">
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>

  <div class="split-hero-overlay">
    {%- if section.settings.heading != blank -%}
      <h2 class="split-hero-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="split-hero-buttons">
        {%- for block in section.blocks -%}
          {%- if block.type == 'button' -%}
            <a href="{{ block.settings.button_link }}" class="split-hero-btn" {{ block.shopify_attributes }}>
              {{ block.settings.button_label }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>



{% schema %}
{
  "name": "Split Hero Overlay",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left Image"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "Right Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Perfect Fit"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Split Hero Overlay",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "button_label": "Shop Men's Jeans"
          }
        },
        {
          "type": "button",
          "settings": {
            "button_label": "Shop Women's Jeans"
          }
        },
        {
          "type": "button",
          "settings": {
            "button_label": "Explore the Fit Guide +"
          }
        }
      ]
    }
  ]
}
{% endschema %}
